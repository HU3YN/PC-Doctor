# Copy to .env and fill in. Never commit the real file.

# The bot token from the Discord Developer Portal (Bot > Reset Token).
DISCORD_BOT_TOKEN=

# Servers the bot may work in, comma separated (right-click a server > Copy Server ID).
# Add a server only after its moderators have approved the bot.
# The bot leaves any server that is not listed, and will not start with none.
DISCORD_GUILD_IDS=

# Where the bot reaches the PC Doctor API.
PCDOCTOR_URL=http://localhost:8080

# The address people open in a browser (used for the private link).
# Defaults to PCDOCTOR_URL.
PCDOCTOR_PUBLIC_URL=

# Largest attachment the bot will download, in MB. Default 200.
PCDOCTOR_MAX_UPLOAD_MB=200

# Seconds one person must wait between /diagnose uses. Default 60.
PCDOCTOR_COOLDOWN_SECONDS=60
