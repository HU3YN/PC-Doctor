# Copy to .env and change what you need. .env is git-ignored: never commit it.

# --- Docker Compose -------------------------------------------------------
# Database password. Change it before letting anything else reach the stack.
POSTGRES_PASSWORD=pcdoctor
# Where the dashboard listens. 127.0.0.1 = this computer only (the safe
# default: it serves plain HTTP). Use 0.0.0.0 to reach it from other PCs on a
# network you trust, e.g. to upload from the collector with -UploadUrl. Never
# expose it to the internet without HTTPS (deploy/README.md).
PCDOCTOR_BIND=127.0.0.1
PCDOCTOR_PORT=8080

# --- API (also read when running without Docker) ---------------------------
# Largest upload accepted, in megabytes.
PCDOCTOR_MAX_UPLOAD_MB=200
# Without Docker: leave unset to use a SQLite file in ./data, or point at
# PostgreSQL:  postgresql://user:password@localhost:5432/pcdoctor
# PCDOCTOR_DATABASE_URL=
# PCDOCTOR_DATA_DIR=data

# --- AI helper (optional) ----------------------------------------------------
# Drafts work-log entries and describes photos, only when you press the button.
# Text and photos you ask it about are sent to Anthropic. Leave empty to keep
# it off. Set a monthly spending limit in the Anthropic console.
# ANTHROPIC_API_KEY=

# --- Sign-in with Discord or Google (optional, docs/oauth.md) ----------------
# The address people type into the browser, e.g. https://pcdoctor.example.com.
# OAuth builds its "come back here" address from it; it is never guessed.
# PCDOCTOR_PUBLIC_URL=
# From the Discord developer portal (OAuth2). Both or neither.
# PCDOCTOR_DISCORD_CLIENT_ID=
# PCDOCTOR_DISCORD_CLIENT_SECRET=
# From Google Cloud console (OAuth client, type "Web application"). Both or neither.
# PCDOCTOR_GOOGLE_CLIENT_ID=
# PCDOCTOR_GOOGLE_CLIENT_SECRET=
# false = only identities the master linked can sign in; true = anyone who
# signs in gets a member account that sees only its own runs.
# PCDOCTOR_OAUTH_SIGNUP=false

# --- Notifications (optional) --------------------------------------------------
# A Discord webhook URL told the headline of each new guest run. Treat it as
# a secret: anyone with it can post to that channel.
# PCDOCTOR_NOTIFY_WEBHOOK_URL=

# --- Discord bot (optional, bot/README.md) -------------------------------------
# Shared secret the bot sends with uploads so they count against their own
# limit instead of the 30-an-hour guest limit. It reads nothing.
# PCDOCTOR_BOT_TOKEN=
# Uploads an hour allowed with the bot token.
# PCDOCTOR_BOT_UPLOADS_PER_HOUR=300

# --- Scale-out and monitoring (optional, docker-compose.scale.yml, deploy/) ---
# Redis: the upload queue and shared rate limits. Set by docker-compose.scale.yml.
# PCDOCTOR_REDIS_URL=redis://localhost:6379/0
# Prometheus reads /api/metrics only with this token. Empty = no metrics.
# Change the scale file's default (local-metrics) before exposing anything.
# PCDOCTOR_METRICS_TOKEN=
# Grafana's admin password (docker-compose.scale.yml). Change the default.
# GRAFANA_PASSWORD=
