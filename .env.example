# Copy to .env and change what you need. .env is git-ignored: never commit it.

# --- Docker Compose -------------------------------------------------------
# Database password. Change it before letting anything else reach the stack.
POSTGRES_PASSWORD=pcdoctor
# Where the dashboard listens. 127.0.0.1 = this computer only (the safe
# default: there are no logins yet). Use 0.0.0.0 to reach it from other PCs
# on a network you trust, e.g. to upload from the collector with -UploadUrl.
PCDOCTOR_BIND=127.0.0.1
PCDOCTOR_PORT=8080

# --- API (also read when running without Docker) ---------------------------
# Largest upload accepted, in megabytes.
PCDOCTOR_MAX_UPLOAD_MB=200
# Without Docker: leave unset to use a SQLite file in ./data, or point at
# PostgreSQL:  postgresql://user:password@localhost:5432/pcdoctor
# PCDOCTOR_DATABASE_URL=
# PCDOCTOR_DATA_DIR=data

# --- AI helper (optional) ----------------------------------------------------
# Drafts work-log entries and describes photos, only when you press the button.
# Text and photos you ask it about are sent to Anthropic. Leave empty to keep
# it off. Set a monthly spending limit in the Anthropic console.
# ANTHROPIC_API_KEY=
